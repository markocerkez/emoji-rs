from typing import Optional

class Core:
    def __init__(self, keys: list[str], e: list[float], status: list[int], component: int) -> None: ...
    def set_names(self, lang: str, names: list[Optional[str]]) -> None: ...
    def set_aliases(self, aliases: list[Optional[str]]) -> None: ...
    def has_language(self, lang: str) -> bool: ...
    def demojize(self, string: str, d0: str, d1: str, lang: str, use_alias: bool,
                 version: Optional[float], handle_version: Optional[str], keep_zwj: bool) -> Optional[str]: ...
    def replace_emoji(self, string: str, replace: str, version: float, keep_zwj: bool) -> Optional[str]: ...
    def emoji_list(self, string: str) -> Optional[list[dict]]: ...
    def emoji_strings(self, string: str) -> Optional[list[str]]: ...
    def emoji_count(self, string: str) -> Optional[int]: ...
    def purely_emoji(self, string: str) -> Optional[bool]: ...
